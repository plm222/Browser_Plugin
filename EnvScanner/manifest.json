{
  "manifest_version": 3,
  "name": "指纹与缓存透视镜",
  "version": "3.0",
  "description": "展示IP、硬件指纹、真实请求头与当前页面局部特征",
  "permissions": [
    "activeTab",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "查看指纹与缓存"
  }
}